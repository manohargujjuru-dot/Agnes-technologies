# Aiven PostgreSQL — Console → service → Overview → Connection information
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require
DATABASE_CA_PATH=./ca.pem          # local only; on Vercel set DATABASE_CA to the PEM text

PORT=4000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Used once by `npm run db:seed` to create the first admin user
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_EMAIL=                       # optional; enables "Forgot password" for this admin

# Site address used in password-reset emails (Vercel sets its own automatically)
# APP_URL=https://your-domain.com

# Email server — needed for "Forgot password" emails and enquiry notifications
# (e.g. Gmail: smtp.gmail.com / 465 / your address / an App Password)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# NOTIFY_TO=
